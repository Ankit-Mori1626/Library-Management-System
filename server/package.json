{
    "name": "lms-server",
    "private": true,
    "scripts": {
        "dev": "node --watch server.js",
        "start": "node server.js",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results/junit.xml",
        "lint": "eslint .",
        "audit:prod": "npm audit --omit=dev --audit-level=high"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.5.1",
        "nodemailer": "^6.9.14"
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@vitest/coverage-v8": "^4.1.12",
        "eslint": "^9.17.0",
        "globals": "^15.14.0",
        "vitest": "^4.1.12"
    }
}
